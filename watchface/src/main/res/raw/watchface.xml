<WatchFace
    height="450"
    width="450">
    <Metadata
        key="CLOCK_TYPE"
        value="DIGITAL" />
    <Scene>
        <DigitalClock
            height="450"
            width="450"
            x="0"
            y="0">
            <TimeText
                format="hh:mm"
                height="80"
                width="450"
                x="0"
                y="50">
                <Variant
                    mode="AMBIENT"
                    target="alpha"
                    value="0" />
                <Font
                    color="#ffffffff"
                    family="SYNC_TO_DEVICE"
                    size="80" />
            </TimeText>
            <TimeText
                alpha="0"
                format="hh:mm"
                height="80"
                width="450"
                x="0"
                y="50">
                <Variant
                    mode="AMBIENT"
                    target="alpha"
                    value="255" />
                <Font
                    color="#ffffffff"
                    family="SYNC_TO_DEVICE"
                    size="80"
                    weight="THIN" />
            </TimeText>
        </DigitalClock>
        <ComplicationSlot slotId="BITCOIN_PRICE"
            x="0" y="220" width="450" height="32"
            supportedTypes="SHORT_TEXT">
            <BoundingBox x="0" y="0" width="450" height="32" />
            <DefaultProviderPolicy
                defaultSystemProvider="EMPTY"
                defaultSystemProviderType="SHORT_TEXT"
                primaryProvider="com.example.mywatchface.BitcoinComplicationService"
                primaryProviderType="SHORT_TEXT" />
            <Complication type="SHORT_TEXT">
                <PartText x="0" y="0" width="450" height="32">
                    <Text>
                        <Font family="SYNC_TO_DEVICE" size="22" color="#ffcccccc">
                            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TEXT]" />
                            </Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>
    </Scene>
</WatchFace>
